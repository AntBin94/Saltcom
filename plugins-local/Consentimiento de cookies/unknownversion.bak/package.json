{
  "name": "@saltcorn/consentimientocookies",
  "version": "0.1.1",
  "description": "Módulo de consentgimiento de Cookies para Saltcorn",
  "main": "index.js",
  "dependencies": {
    "cheerio": "1.0.0-rc.12"
  },
  "author": "AntBin94",
  "license": "MIT",
